{
  "name": "tabby-docker-console",
  "version": "0.1.5",
  "description": "Remote Docker management panel for Tabby SSH sessions — containers, images, logs, stats and exec terminal over SSH",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "docker",
    "ssh",
    "containers"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "verify:package": "node scripts/verify-package.js",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "jeishod",
  "license": "MIT",
  "devDependencies": {
    "@angular/animations": "^15.2.0",
    "@angular/cdk": "^15.2.0",
    "@angular/common": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@ngx-translate/core": "^14.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/node": "^20.0.0",
    "@types/webpack-env": "^1.18.0",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.0.0",
    "ngx-toastr": "^15.0.0",
    "ngx-translate-messageformat-compiler": "6.5.1",
    "pug": "^2.0.4",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.5.0",
    "sass": "^1.50.0",
    "sass-loader": "^13.0.0",
    "style-loader": "^3.0.0",
    "@xterm/xterm": "^5.4.0",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-ssh": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-loader": "^9.4.0",
    "typescript": "~4.8.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "peerDependencies": {
    "tabby-core": ">=1.0.231-nightly.0 <1.1.0",
    "tabby-terminal": ">=1.0.231-nightly.0 <1.1.0"
  },
  "overrides": {
    "ngx-translate-messageformat-compiler": "6.5.1"
  },
  "homepage": "https://github.com/Jeishod/tabby-docker-console#readme",
  "bugs": {
    "url": "https://github.com/Jeishod/tabby-docker-console/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeishod/tabby-docker-console"
  }
}
